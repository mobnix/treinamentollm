# Copie para .env e ajuste. Nenhuma variavel e obrigatoria: sem .env, roda em
# modo mock, offline e deterministico, ideal para a sala de aula.

PORT=3000
JWT_SECRET=troque-este-segredo
TOKEN_TTL=12h
DB_PATH=./data/warzone.db

# Motor: mock (default) ou proxy
LLM_ENGINE=mock

# Cenario ficticio (reutilizavel)
SCENARIO_NAME=Meridian Retail
ASSISTANT_NAME=Aria
PUBLIC_SCOREBOARD=true

# Apenas para LLM_ENGINE=proxy (endpoint compativel com a API de chat da OpenAI)
# LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
